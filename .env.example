# ---- Luceed API (required) ----
# Base URL must include /datasnap/rest/ (trailing slash optional)
# When using SSH tunnel, point at the local forward, e.g.:
#   LUCEED_BASE_URL=http://127.0.0.1:18080/datasnap/rest/
LUCEED_BASE_URL=http://127.0.0.1:18080/datasnap/rest/
LUCEED_USERNAME=readonly_user
LUCEED_PASSWORD=change_me
LUCEED_TIMEOUT_MS=60000
# Keep true for MCP safety (only GET; blocks obvious mutating paths)
LUCEED_READ_ONLY=true

# ---- MCP transport ----
# stdio  = Claude Desktop / Cursor local spawn
# http   = remote Docker / Claude / ChatGPT connectors
MCP_TRANSPORT=http
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8080
MCP_HTTP_PATH=/mcp
# Strongly recommended for remote HTTP
MCP_AUTH_TOKEN=generate_a_long_random_secret
# Optional DNS-rebinding allowlist when binding 0.0.0.0 (comma-separated Host headers)
# MCP_ALLOWED_HOSTS=luceed-mcp.example.com,localhost

# ---- SSH tunnel (Luceed IP whitelist) ----
# Enable when the MCP host is NOT on the whitelisted IP and must jump via bastion.
SSH_ENABLED=false
SSH_HOST=bastion.example.com
SSH_PORT=22
SSH_USER=tunnel
# Prefer key file mount in Docker; or paste PEM with \n newlines into SSH_PRIVATE_KEY
SSH_PRIVATE_KEY_PATH=/run/secrets/ssh_key
# SSH_PRIVATE_KEY=
SSH_REMOTE_HOST=luceed-internal-or-127.0.0.1
SSH_REMOTE_PORT=80
SSH_LOCAL_PORT=18080
SSH_STRICT_HOST_KEY_CHECKING=false
# SSH_KNOWN_HOSTS_PATH=/run/secrets/known_hosts
