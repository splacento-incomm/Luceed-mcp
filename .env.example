# ---- Image (optional) ----
# Default: ghcr.io/splacento-incomm/luceed-mcp:latest
# LUCEED_MCP_IMAGE=ghcr.io/splacento-incomm/luceed-mcp:latest

# ---- Luceed API (required) ----
# Base URL must include /datasnap/rest/ (trailing slash optional)
# When using SSH tunnel, point at the local forward:
#   LUCEED_BASE_URL=http://127.0.0.1:18080/datasnap/rest/
LUCEED_BASE_URL=http://127.0.0.1:18080/datasnap/rest/
LUCEED_USERNAME=readonly_user
LUCEED_PASSWORD=change_me
LUCEED_TIMEOUT_MS=60000
# Keep true for MCP safety (only GET; blocks obvious mutating paths)
LUCEED_READ_ONLY=true

# ---- MCP transport (HTTP for remote Claude / ChatGPT) ----
MCP_TRANSPORT=http
MCP_HTTP_HOST=0.0.0.0
# Host port mapped to container 8080 (compose binds 127.0.0.1 only)
MCP_HTTP_PORT=8080
# Unguessable path — reverse-proxy this publicly
MCP_HTTP_PATH=/mcp-CHANGE_ME_TO_LONG_RANDOM
# Static token for Cursor / curl (Bearer or X-Api-Key). Still accepted with OAuth on.
MCP_AUTH_TOKEN=CHANGE_ME_TO_LONG_RANDOM_SECRET

# ---- OAuth (required for ChatGPT and Claude web connectors) ----
# Setting MCP_PUBLIC_URL turns OAuth on. Public origin only, no path.
# MCP_PUBLIC_URL=https://mcp.example.com
# Password typed on the login page when ChatGPT / Claude connects
# MCP_OAUTH_PASSWORD=CHANGE_ME
# HMAC key for issued tokens (openssl rand -hex 32). Changing it logs everyone out.
# MCP_OAUTH_SECRET=CHANGE_ME_64_HEX_CHARS
# Reverse-proxy hops in front of the container (Apache = 1)
# MCP_TRUST_PROXY=1
# Optional DNS-rebinding allowlist (comma-separated Host headers)
# MCP_ALLOWED_HOSTS=mcp.example.com,localhost

# ---- SSH tunnel (Luceed IP whitelist / private network) ----
# Mount key at ./secrets/ssh_key (chmod 600, owned by container uid 10001)
#   chmod 755 secrets && chown 10001:10001 secrets/ssh_key
#
# SSH_HOST        = bastion the MCP host can reach (often private IP, e.g. 10.0.0.3)
#                   Do NOT use a Cloudflare-proxied public hostname here.
# SSH_REMOTE_HOST = Luceed host as seen FROM the bastion (e.g. luceedapi.example.com)
#                   Do NOT set this to the bastion's own IP unless Luceed listens there.
SSH_ENABLED=false
SSH_HOST=10.0.0.3
SSH_PORT=22
SSH_USER=deploy
SSH_PRIVATE_KEY_PATH=/run/secrets/ssh_key
# SSH_PRIVATE_KEY=
SSH_REMOTE_HOST=luceedapi.example.com
SSH_REMOTE_PORT=3767
SSH_LOCAL_PORT=18080
SSH_STRICT_HOST_KEY_CHECKING=false
# SSH_KNOWN_HOSTS_PATH=/run/secrets/known_hosts
